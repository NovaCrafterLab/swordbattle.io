# Solana区块链配置环境变量示例
# 复制到 .env 文件并设置相应的值

# ==================== Solana配置 ====================

# Solana区块链服务开关 (默认启用)
SOLANA_BLOCKCHAIN_ENABLED=true

# Helius RPC API 密钥池 (推荐配置多个密钥，用逗号分隔)
# 获取密钥：https://www.helius.dev/
RPC_API_KEYS_POOL=your-helius-key-1,your-helius-key-2,your-helius-key-3

# Solana程序配置 - Devnet
VAULT_PROGRAM_ID_DEVNET=11111111111111111111111111111112
TOKEN_MINT_DEVNET=Hk4BerAoKbemG277HShrk8DSHiMEUKbm6D23RKhLDLKq

# Solana程序配置 - Mainnet
VAULT_PROGRAM_ID_MAINNET=11111111111111111111111111111112
TOKEN_MINT_MAINNET=So11111111111111111111111111111111111111112

# 通用配置 (如果没有设置环境特定的值，将使用这些)
VAULT_PROGRAM_ID=11111111111111111111111111111112
TOKEN_MINT=So11111111111111111111111111111111111111112

# ==================== BSC配置 (已弃用，仅供兼容) ====================

# BSC区块链服务开关 (默认禁用，推荐保持禁用)
BLOCKCHAIN_ENABLED=false

# BSC RPC URL (如果启用BSC服务)
BLOCKCHAIN_RPC_URL=https://rpc.ankr.com/bsc

# BSC合约地址 (如果启用BSC服务)
GAME_AGGREGATOR_CONTRACT_TESTNET=0x6810494B605ac1A6259788Db999202f5578dA4E1
GAME_AGGREGATOR_CONTRACT_MAINNET=0x0E1124B236e454EA325c33aBBb561D38b255Da6c

# BSC私钥 (如果启用BSC服务)
TRUSTED_SIGNER_PRIVATE_KEY=your-bsc-private-key

# ==================== 应用配置 ====================

# 构建环境
BUILD_ENV=development  # development | production

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/swordbattle
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=swordbattle

# 应用端口
PORT=4000

# JWT密钥
JWT_SECRET=your-jwt-secret-key

# Recaptcha配置
RECAPTCHA_SECRET_KEY=your-recaptcha-secret