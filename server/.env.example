# ================================
# Swordbattle.io Server Configuration
# Secure Tier-based Gaming System
# ================================

# Server Configuration
SERVER_PORT=8000
SERVER_TYPE=RACE
DEBUG=TRUE
ENABLE_CYCLE_RESTART=true

# Solana Blockchain Configuration
SOLANA_ENABLED=true
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_server_private_key_hex
VAULT_PROGRAM_ID=AqDb3BxQhL5wmszt3iy8qrvPJ9Mu5MeF5uoUd1e65EaV
SOLANA_TOKEN_MINT=So11111111111111111111111111111112

# ================================
# TIER-BASED GAMING CONFIGURATION
# ================================

# Low Tier Arena (Beginner-friendly)
LOW_TIER_ENTRANCE_FEE=0.01        # 0.01 SOL entrance fee
LOW_TIER_KILL_REWARD=0.001        # 0.001 SOL per kill

# Medium Tier Arena (Intermediate)
MID_TIER_ENTRANCE_FEE=0.05        # 0.05 SOL entrance fee  
MID_TIER_KILL_REWARD=0.005        # 0.005 SOL per kill

# High Tier Arena (Advanced)
HIGH_TIER_ENTRANCE_FEE=0.1         # 0.1 SOL entrance fee
HIGH_TIER_KILL_REWARD=0.01         # 0.01 SOL per kill

# ================================
# SECURITY CONFIGURATION
# ================================

# Price Validation Security
ENABLE_STRICT_PRICE_VALIDATION=true    # Enforce exact price matching
ALLOW_PRICE_DEVIATION=0                # 0% price deviation allowed
REQUIRE_EXACT_TIER_MATCH=true          # Require exact tier matching

# Additional Security Settings
# These are hardcoded for security but can be made configurable:
# - Rate limiting: 5 requests per minute per wallet
# - Level restrictions enforced by tier
# - Input validation and sanitization
# - Security event logging

# ================================
# EXAMPLE TIER CONFIGURATIONS
# ================================

# Example 1: Development/Testing (Lower fees)
# LOW_TIER_ENTRANCE_FEE=0.001
# MID_TIER_ENTRANCE_FEE=0.005  
# HIGH_TIER_ENTRANCE_FEE=0.01

# Example 2: Production (Higher fees)
# LOW_TIER_ENTRANCE_FEE=0.05
# MID_TIER_ENTRANCE_FEE=0.2
# HIGH_TIER_ENTRANCE_FEE=0.5

# Example 3: Tournament Mode (Very high stakes)
# LOW_TIER_ENTRANCE_FEE=0.1
# MID_TIER_ENTRANCE_FEE=0.5
# HIGH_TIER_ENTRANCE_FEE=1.0

# ================================
# SECURITY NOTES
# ================================

# 1. All entrance fees are validated server-side
# 2. Users cannot bypass pricing by manipulating client requests  
# 3. Level restrictions prevent inappropriate tier access
# 4. Rate limiting prevents spam attacks
# 5. All transactions are logged for audit purposes
# 6. Price validation ensures exact fee matching
# 7. Invalid tier requests are rejected with detailed error messages

# ================================
# API USAGE EXAMPLE
# ================================

# To buy a ticket for medium tier arena:
# POST /api/buy-ticket
# {
#   "gameId": 123,
#   "amount": "50000000",           // 0.05 SOL in lamports
#   "walletAddress": "user_wallet", 
#   "tier": "medium",               // Required for validation
#   "playerLevel": 15               // Must be 11-25 for medium tier
# }

# Server will validate:
# ✓ Tier exists and is valid
# ✓ Amount matches exact tier price (50000000 lamports = 0.05 SOL)
# ✓ Player level is within tier range (11-25)
# ✓ Game ID matches current active game
# ✓ Rate limits not exceeded
# ✓ All input validation passes